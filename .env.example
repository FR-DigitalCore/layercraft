# Copier en `.env` et compléter. Les valeurs par défaut suffisent pour un
# démarrage local ; voir docs/DEMARRAGE.md pour la mise en ligne.

# --- Base de données -----------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/impression3d"

# Lus par docker-compose pour provisionner Postgres : à garder cohérents
# avec DATABASE_URL.
POSTGRES_DB="impression3d"
POSTGRES_USER="user"
POSTGRES_PASSWORD="password"

# --- Authentification admin ----------------------------------------------
# openssl rand -base64 32
NEXTAUTH_SECRET="changeme"
# Facultatif : l'hôte est déduit de la requête (trustHost dans auth.config.ts).
NEXTAUTH_URL="http://localhost:3000"
ADMIN_EMAIL="admin@votredomaine.fr"
# npm run hash-password -- "votre-mot-de-passe"
ADMIN_PASSWORD_HASH="bcrypt_hash_ici"

# --- Site ----------------------------------------------------------------
# Liens des emails, sitemap, Open Graph. Figée dans le bundle client au
# build : la renseigner AVANT `docker compose build`.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- MinIO (stockage des fichiers) ---------------------------------------
# Endpoint interne ; docker-compose le surcharge à « minio ».
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET_STL="stl-files"
MINIO_BUCKET_GALERIE="galerie"
# Doit rester renseignée : sans elle, le client S3 résout la région par un
# appel réseau, ce qui casse la signature des URLs publiques.
MINIO_REGION="us-east-1"

# Endpoint public, celui que le navigateur contacte. La signature des
# presigned URLs couvre le Host : elle doit être calculée sur le domaine
# réellement visité. À ne décommenter qu'en production — en local, le mode
# dev et docker-compose s'en chargent.
# MINIO_PUBLIC_ENDPOINT="fichiers.votredomaine.fr"
# MINIO_PUBLIC_PORT="443"
# MINIO_PUBLIC_USE_SSL="true"

# URL de la console MinIO si vous l'exposez (sinon laisser vide).
MINIO_CONSOLE_URL=""

# --- Emails (Resend) -----------------------------------------------------
# Sans clé, les emails sont écrits en console au lieu d'être envoyés.
RESEND_API_KEY=""
RESEND_FROM="devis@votredomaine.fr"
ADMIN_NOTIF_EMAIL="admin@votredomaine.fr"

# --- Stripe (facultatif) -------------------------------------------------
# Sans clé, l'encaissement se fait hors ligne et le bouton de règlement
# n'apparaît pas. Le secret du webhook vient de `stripe listen` ou du
# dashboard ; sans lui, les notifications de paiement sont rejetées.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Mondial Relay (facultatif) ------------------------------------------
# Sans identifiants, le client saisit le numéro de son point relais, que
# vous confirmez au devis. Le transporteur s'active depuis l'admin.
MONDIAL_RELAY_ENSEIGNE=""
MONDIAL_RELAY_CLE_PRIVEE=""

# --- Umami (facultatif) --------------------------------------------------
# Pointe vers une instance existante : l'application n'en héberge pas. Sans
# ces deux valeurs, aucun script de suivi n'est chargé. Figées au build.
NEXT_PUBLIC_UMAMI_URL=""
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""

# --- Déploiement (docker-compose) ----------------------------------------
# Ports publiés sur la machine hôte, à changer si un service les occupe
# déjà. Ils n'affectent QUE l'hôte : dans le réseau Docker, l'app continue
# de joindre postgres:5432 et minio:9000.
# APP_HOST_PORT="3000"
# POSTGRES_HOST_PORT="5432"
# MINIO_HOST_PORT="9000"
# MINIO_CONSOLE_HOST_PORT="9001"

# Nom du réseau Docker de votre reverse proxy, que `app` et `minio`
# rejoignent. `docker network ls` vous le donne (souvent `npm_default`).
# Sans reverse proxy : docker network create proxy
RESEAU_PROXY="proxy"
