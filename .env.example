# Base de données
DATABASE_URL="postgresql://user:password@localhost:5432/impression3d"

# Utilisés par docker-compose pour provisionner Postgres
POSTGRES_DB="impression3d"
POSTGRES_USER="user"
POSTGRES_PASSWORD="password"

# Ports publiés sur la machine hôte. À changer si un service tourne déjà sur
# ces ports (un Postgres local, par exemple). Ils n'affectent QUE l'hôte :
# dans le réseau Docker, l'app continue de joindre postgres:5432 et
# minio:9000, et docker-compose aligne tout seul l'URL publique de MinIO.
# APP_HOST_PORT="3000"
# POSTGRES_HOST_PORT="5432"
# MINIO_HOST_PORT="9000"
# MINIO_CONSOLE_HOST_PORT="9001"

# Auth admin
# Générer un secret : openssl rand -base64 32
NEXTAUTH_SECRET="changeme"
NEXTAUTH_URL="http://localhost:3000"
ADMIN_EMAIL="admin@votredomaine.fr"
# Générer le hash : npm run hash-password -- "votre-mot-de-passe"
ADMIN_PASSWORD_HASH="bcrypt_hash_ici"

# MinIO — endpoint interne (docker-compose le surcharge à "minio")
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET_STL="stl-files"
MINIO_BUCKET_GALERIE="galerie"
MINIO_USE_SSL="false"

# MinIO — endpoint public, celui que le navigateur contacte.
# La signature des presigned URLs couvre le Host : elle doit être calculée sur
# le domaine réellement visité.
#
# Trois cas de figure :
#
# 1. `npm run dev` avec MinIO en Docker : laisser commenté. L'endpoint interne
#    (localhost:9000) est repris en entier, le navigateur y accède déjà.
# 2. App lancée dans Docker aussi : ne rien toucher non plus. docker-compose
#    renseigne ces variables pour vous, sur localhost et le port publié.
# 3. Production : décommenter et pointer sur le sous-domaine servi par Nginx
#    vers minio:9000 (voir deploy/nginx.conf.example).
# MINIO_PUBLIC_ENDPOINT="fichiers.votredomaine.fr"
# MINIO_PUBLIC_PORT="443"
# MINIO_PUBLIC_USE_SSL="true"
# URL de la console MinIO, si vous l'exposez (sinon laisser vide)
MINIO_CONSOLE_URL=""

# Resend — laisser vide en dev : les emails sont alors loggés en console
RESEND_API_KEY=""
RESEND_FROM="devis@votredomaine.fr"
ADMIN_NOTIF_EMAIL="admin@votredomaine.fr"

# URL publique du site (liens dans les emails, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
