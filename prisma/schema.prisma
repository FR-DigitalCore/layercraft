generator client {
  provider = "prisma-client-js"
  // linux-musl-openssl-3.0.x : image Docker Alpine. Sans ça, le moteur de
  // requête manque à l'exécution dans le conteneur.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Devis {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid()) // pour URL suivi public
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Compte client rattaché. Créé à la volée depuis l'email de la demande :
  /// le client n'a rien à faire pour que ses devis se regroupent, il lui
  /// suffit ensuite de se connecter avec cette adresse.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Contact
  nom       String
  email     String
  telephone String?
  message   String?

  // Config impression
  matiere  String // PLA, PETG, ASA, TPU
  couleur  String?
  qualite  String // draft | standard | fine
  quantite Int     @default(1)

  // Fichier
  stlKey String? // clé MinIO
  stlNom String?

  /// Volume de matière mesuré sur le STL, en cm³ (null si aucun fichier).
  volumeCm3 Float?

  // Livraison
  modeLivraison   ModeLivraison @default(RETRAIT)
  adresseLigne1   String?
  adresseLigne2   String?
  codePostal      String?
  ville           String?
  pays            String        @default("FR")
  /// Point relais Mondial Relay retenu par le client
  pointRelaisId   String?
  pointRelaisNom  String?
  /// Masse estimée de la commande, en grammes, qui détermine le tarif de port
  masseG          Float?
  fraisPort       Float?

  // Suivi
  statut     Statut  @default(RECU)
  prixEstime Float?
  prixFinal  Float?
  noteAdmin  String?

  // Paiement Stripe
  stripeSessionId       String?   @unique
  stripePaymentIntentId String?
  payeLe                DateTime?

  evenements EvenementDevis[]

  @@index([email])
  @@index([statut])
  @@index([userId])
}

enum ModeLivraison {
  RETRAIT
  COLISSIMO
  MONDIAL_RELAY
}

/// Grille de port au poids, éditable depuis /admin/livraison.
/// Le palier retenu est le plus petit poidsMaxG qui couvre la masse.
model TarifLivraison {
  id           String        @id @default(cuid())
  transporteur ModeLivraison
  poidsMaxG    Int
  prix         Float
  updatedAt    DateTime      @updatedAt

  @@unique([transporteur, poidsMaxG])
}

/// Historique des changements de statut, utilisé par la timeline de /suivi/[token]
model EvenementDevis {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  devisId   String
  devis     Devis    @relation(fields: [devisId], references: [id], onDelete: Cascade)
  statut    Statut
  commentaire String?

  @@index([devisId])
}

enum Statut {
  RECU
  EN_ETUDE
  /// Devis chiffré et envoyé : en attente du règlement par le client.
  ACCEPTE
  PAYE
  EN_IMPRESSION
  TERMINE
  EXPEDIE
  ANNULE
}

/// Comptes clients (Auth.js). La connexion se fait par lien magique :
/// aucun mot de passe n'est stocké. L'administrateur, lui, reste hors base,
/// authentifié par les variables d'environnement.
/// Les noms de champs suivent le contrat de l'adaptateur Auth.js
/// (name, emailVerified, image) : il mappe dessus littéralement, les
/// renommer en français casse la création de compte.
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  devis    Devis[]
  comptes  Account[]
  sessions Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Jetons des liens magiques. Auth.js les supprime à la première
/// utilisation : un lien ne sert qu'une fois.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Grille tarifaire éditable depuis /admin/tarifs.
/// Table vide = valeurs par défaut de lib/prix.ts (GRILLE_DEFAUT).
model TarifMatiere {
  matiere        String   @id // PLA, PETG, ASA, TPU
  prixBase       Float // mode FORFAIT : euros HT par pièce, qualité standard
  prixParGramme  Float    @default(0.08) // modes MATIERE et MATIERE_TEMPS
  densite        Float    @default(1.24) // g/cm³, pour convertir le volume en masse
  updatedAt      DateTime @updatedAt
}

model TarifQualite {
  qualite          String   @id // draft | standard | fine
  multiplicateur   Float // mode FORFAIT
  debitCm3ParHeure Float    @default(8) // mode MATIERE_TEMPS : vitesse d'impression
  updatedAt        DateTime @updatedAt
}

/// Ligne unique (id = "global") : mode de calcul actif et paramètres transverses.
model ParametresTarification {
  id               String   @id @default("global")
  mode             String   @default("FORFAIT") // FORFAIT | MATIERE | MATIERE_TEMPS
  fraisMiseEnRoute Float    @default(5) // forfait fixe par commande
  prixHoraire      Float    @default(4) // euros HT par heure machine
  tauxRemplissage  Float    @default(0.25) // 0,25 = 25 % d'infill
  volumeParDefaut  Float    @default(30) // cm³ retenus quand aucun STL n'est fourni
  updatedAt        DateTime @updatedAt
}

model RemiseQuantite {
  id          String   @id @default(cuid())
  seuil       Int      @unique // à partir de N pièces
  coefficient Float // 0.85 = -15 %
  updatedAt   DateTime @updatedAt
}

model Realisation {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  titre       String
  description String?
  imageKey    String // clé MinIO
  matiere     String?
  tags        String[] // ex: ["pièce technique", "PETG"]
  visible     Boolean  @default(true)
  ordre       Int      @default(0)

  @@index([visible, ordre])
}
